<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <com.dd.ShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorSecondary"
            app:sl_shadowRadius="20dp"
            app:sl_shadowColor="@color/black"
            app:sl_cornerRadius="20dp">

            <Button
                android:id="@+id/buttonRandom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:backgroundTint="@color/transparente"
                android:text="Modo aleatorio"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                 />

        </com.dd.ShadowLayout>
        <com.dd.ShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorSecondary"
            app:sl_shadowRadius="20dp"
            app:sl_shadowColor="@color/black"
            app:sl_cornerRadius="20dp">

            <Button
                android:id="@+id/buttonCharacters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:backgroundTint="@color/transparente"
                android:text="Solo personajes"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                />

        </com.dd.ShadowLayout>
        <com.dd.ShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorSecondary"
            app:sl_shadowRadius="20dp"
            app:sl_shadowColor="@color/black"
            app:sl_cornerRadius="20dp">

            <Button
                android:id="@+id/buttonInfinityLifes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:backgroundTint="@color/transparente"
                android:text="Vidas infinitas"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                />

        </com.dd.ShadowLayout>
    </LinearLayout>

</RelativeLayout>

