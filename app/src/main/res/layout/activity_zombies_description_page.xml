<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="?attr/colorPrimaryVariant"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ZombiesDescriptionPage">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--TODO EL CONTENIDO DE DENTRO-->


            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewCyberpunk"
                android:layout_width="380dp"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                android:layout_marginTop="50dp"
                app:cardCornerRadius="20dp">

                <!-- Contenido de la tarjeta -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/Cyberpunk_img"
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/twd" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Titulo_game"
                            android:text="Zombies"/>

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/save_btn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:lottie_rawRes="@raw/animation_save"
                            />
                    </LinearLayout>



                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <View
                android:layout_marginTop="20dp"
                android:layout_width="260dp"
                android:layout_gravity="center"
                android:layout_height="3dp"
                android:background="@color/verde"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!--TODO EL CONTENIDO DE DENTRO-->
                <TextView
                    style="@style/Titulos_grandes"
                    android:layout_marginStart="110dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    />
                <TextView
                    style="@style/Titulos_grandes"
                    android:layout_marginStart="50dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.8k"
                    />
                <TextView
                    android:id="@+id/textViewCounter"
                    style="@style/Titulos_grandes"
                    android:layout_marginStart="50dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="350"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!--TODO EL CONTENIDO DE DENTRO-->
                <TextView
                    style="@style/Titulos_grandes"
                    android:layout_marginStart="80dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preguntas"
                    />
                <TextView
                    style="@style/Titulos_grandes"
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visitas"
                    />
                <TextView
                    style="@style/Titulos_grandes"
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Favoritos"
                    />
            </LinearLayout>
            <View
                android:layout_width="260dp"
                android:layout_gravity="center"
                android:layout_height="4dp"
                android:background="@color/verde"/>
            <TextView
                style="@style/Titulo"
                android:layout_margin="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textAlignment="center"
                android:text="¿Estás listo para enfrentarte a hordas de preguntas sobre zombies? ¡Demuestra tus habilidades con este quiz apocalíptico!"
                />
            <TextView
                android:layout_marginTop="20dp"
                style="@style/Titulo_game"
                android:layout_marginStart="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comentarios"
                />


        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/fab"
        style="@style/buttonflatPLAY"
        android:text="Jugar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>